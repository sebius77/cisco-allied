{
    "name": "sebius77/cisco-allied",
    "description": "Bibliothèque légère pour piloter des switchs Cisco (IOS) et Allied Telesis (AlliedWare Plus) en SSH depuis PHP, basée sur phpseclib/phpseclib v3.0.",
    "keywords": ["cisco", "allied", "switch", "ssh", "phpseclib"],
    "type": "library",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Sébastien Gaudin",
            "email": "sebastien.gaudin@universite-paris-saclay.fr"
        }
    ],
    "require": {
        "php": ">=8.2",
        "phpseclib/phpseclib": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\Network\\": "src/"
        }
    }
}
